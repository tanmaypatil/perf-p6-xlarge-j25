<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.perf</groupId>
  <artifactId>parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>p6-xlarge-j25</name>
  <modules>
    <module>mod-l0-0</module>
    <module>mod-l0-1</module>
    <module>mod-l1-0</module>
    <module>mod-l1-1</module>
    <module>mod-l1-2</module>
    <module>mod-l1-3</module>
    <module>mod-l1-4</module>
    <module>mod-l1-5</module>
    <module>mod-l1-6</module>
    <module>mod-l1-7</module>
    <module>mod-l2-0</module>
    <module>mod-l2-1</module>
    <module>mod-l2-2</module>
    <module>mod-l2-3</module>
    <module>mod-l2-4</module>
    <module>mod-l2-5</module>
    <module>mod-l2-6</module>
    <module>mod-l2-7</module>
    <module>mod-l2-8</module>
    <module>mod-l2-9</module>
    <module>mod-l2-10</module>
    <module>mod-l2-11</module>
    <module>mod-l3-0</module>
    <module>mod-l3-1</module>
    <module>mod-l3-2</module>
    <module>mod-l3-3</module>
    <module>mod-l3-4</module>
    <module>mod-l3-5</module>
    <module>mod-l3-6</module>
    <module>mod-l3-7</module>
    <module>mod-l3-8</module>
    <module>mod-l3-9</module>
    <module>mod-l4-0</module>
    <module>mod-l4-1</module>
    <module>mod-l4-2</module>
    <module>mod-l4-3</module>
    <module>mod-l4-4</module>
    <module>mod-l4-5</module>
    <module>mod-l5-0</module>
    <module>mod-l5-1</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Experiment knobs: override with -Dname=value -->
    <maven.compiler.fork>false</maven.compiler.fork>
    <maven.compiler.useIncrementalCompilation>true</maven.compiler.useIncrementalCompilation>
    <maven.compiler.meminitial>128m</maven.compiler.meminitial>
    <maven.compiler.maxmem>1024m</maven.compiler.maxmem>
    <forkCount>1</forkCount>
    <reuseForks>true</reuseForks>
    <surefire.argLine>-Xmx512m</surefire.argLine>
    <junit.parallel.enabled>false</junit.parallel.enabled>
    <junit.parallel.mode>same_thread</junit.parallel.mode>
    <junit.parallel.classes>same_thread</junit.parallel.classes>
    <junit.parallel.factor>1</junit.parallel.factor>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.13.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <argLine>${surefire.argLine}</argLine>
            <trimStackTrace>true</trimStackTrace>
            <properties>
              <configurationParameters>
                junit.jupiter.execution.parallel.enabled=${junit.parallel.enabled}
                junit.jupiter.execution.parallel.mode.default=${junit.parallel.mode}
                junit.jupiter.execution.parallel.mode.classes.default=${junit.parallel.classes}
                junit.jupiter.execution.parallel.config.strategy=dynamic
                junit.jupiter.execution.parallel.config.dynamic.factor=${junit.parallel.factor}
              </configurationParameters>
            </properties>
          </configuration>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.4</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.4.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.1.4</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
